          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interval"
          }
        }
      }
    },
    "Look away from the screen for 20 seconds to rest your eyes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远离屏幕20秒，让眼睛休息一下。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "遠離螢幕20秒，讓眼睛休息一下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look away from the screen for 20 seconds to rest your eyes."
          }
        }
      }
    },
    "Manage your custom reminder intervals. Click the delete button to remove custom intervals.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理您的自定义提醒时长。点击删除按钮可删除自定义时长。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "管理您的自訂提醒時長。點擊刪除按鈕可刪除自定義時長。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage your custom reminder intervals. Click the delete button to remove custom intervals."
          }
        }
      }
    },
