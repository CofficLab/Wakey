    "Please enable notifications in System Settings to receive break reminders.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中启用通知，以便接收休息提醒。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中啟用通知，以便接收休息提醒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enable notifications in System Settings to receive break reminders."
          }
        }
      }
    },
    "Remind you to rest your eyes every 20 minutes": {
      "comment": "Description of what the Eye Care Reminder plugin does",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每20分钟提醒你休息眼睛"
