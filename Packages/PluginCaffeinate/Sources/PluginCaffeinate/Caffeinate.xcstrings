            "value": "1 小時"
          }
        }
      }
    },
    "2 hr": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 小时"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "2 小時"
          }
        }
      }
    },
    "30 min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 分钟"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "30 分鐘"
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "操作"
          }
        }
      }
    },
    "Actions: three anti-sleep modes, each with an icon and a selection checkmark.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作：三种防休眠模式，每项配一个图标，选中时显示对勾。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "操作：三種防休眠模式，每項配一個圖示，選中時顯示打勾。"
          }
        }
      }
    },
    "Add Custom (minutes):": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加自定义(分钟):"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "添加自訂(分鐘):"
          }
        }
      }
    },
    "Add a duration for manual activation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加自定义防休眠时长。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "新增自訂防休眠時長。"
          }
        }
      }
    },
    "Anti-Sleep Durations": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防睡眠时长"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "防睡眠時長"
          }
        }
      }
    },
    "Anti-sleep": {
      "comment": "Poster feature title",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠"
          }
        }
      }
    },
    "Anti-sleep Modes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠模式"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠模式"
          }
        }
      }
    },
    "Anti-sleep mode enabled via Wakey": {
      "comment": "Reason shown in system power assertions when anti-sleep is active",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户通过 Wakey 开启了防休眠模式"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用戶通過 Wakey 開啟了防休眠模式"
          }
        }
      }
    },
    "Auto-restore Timer": {
      "comment": "Feature title",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时自动恢复"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "定時自動恢復"
          }
        }
      }
    },
    "Basic Operations": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基本操作"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "基本操作"
          }
        }
      }
    },
    "Caffeinate": {
      "comment": "Name of the anti-sleep plugin",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠"
          }
        }
      }
    },
    "Caffeinate Poster": {
      "comment": "Name of the caffeinate poster plugin",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠海报"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠海報"
          }
        }
      }
    },
    "Choose a mode under Actions to start anti-sleep; the checkmark marks the active mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「操作」区选择一种模式即可开启防休眠，对勾标识当前生效的模式。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在「操作」區選擇一種模式即可開啟防休眠，打勾標示目前生效的模式。"
          }
        }
      }
    },
    "Click Reset to restore the built-in durations and drop all custom ones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「重置」可恢复内置时长，并清除所有自定义时长。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊「重設」可恢復內建時長，並清除所有自訂時長。"
          }
        }
      }
    },
    "Click the active mode again to stop anti-sleep and release the power assertion.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次点击当前生效的模式可停止防休眠，并释放电源断言。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "再次點擊目前生效的模式可停止防休眠，並釋放電源斷言。"
          }
        }
      }
    },
    "Click the delete button next to a custom duration to remove it. Built-in durations cannot be deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击自定义时长旁的删除按钮即可移除。内置时长不可删除。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊自訂時長旁的刪除按鈕即可移除。內建時長不可刪除。"
          }
        }
      }
    },
    "Click to prevent system from entering sleep mode": {
      "comment": "Feature description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击即可阻止系统进入睡眠模式"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊即可阻止系統進入睡眠模式"
          }
        }
      }
    },
    "Custom Durations": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义时长"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂時長"
          }
        }
      }
    },
    "Custom duration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义时长"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂時長"
          }
        }
      }
    },
    "Custom interval": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义时长"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂時長"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除"
          }
        }
      }
    },
    "Duration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "時長"
          }
        }
      }
    },
    "Duration: a horizontal strip of duration buttons. The selected button is highlighted; the strip scrolls sideways when there are many durations.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长：一排横向排列的时长按钮。选中的按钮会高亮；时长较多时可横向滚动查看。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "時長：一排橫向排列的時長按鈕。選中的按鈕會高亮；時長較多時可橫向捲動檢視。"
          }
        }
      }
    },
    "Ensure screen stays on during presentations or work": {
      "comment": "Feature description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保演示或工作时屏幕不熄灭"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "確保演示或工作時螢幕不熄滅"
          }
        }
      }
    },
    "Enter a positive number of minutes in the Add Custom field and click the add button, or press Return.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「添加自定义(分钟)」输入框中填入大于 0 的分钟数，点击添加按钮或按回车键。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在「新增自訂(分鐘)」輸入框中填入大於 0 的分鐘數，點擊新增按鈕或按回車鍵。"
          }
        }
      }
    },
    "Figure 1: Status-bar popover layout": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图 1：状态栏弹窗布局"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "圖 1：狀態列彈出視窗版面"
          }
        }
      }
    },
    "Indefinite": {
      "comment": "Label for infinite duration",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "永久"
          }
        }
      }
    },
    "Interface": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面说明"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "介面說明"
          }
        }
      }
    },
    "Keep Awake & Allow Display Sleep": {
      "comment": "Option to keep system awake but allow display to sleep",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并允许屏幕关闭"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並允許螢幕關閉"
          }
        }
      }
    },
    "Keep Awake & Allow Display Sleep: prevents system sleep but lets the display turn off. Use it when you only need the computer to keep running.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并允许屏幕关闭：阻止系统休眠，但允许屏幕自动熄灭。只需要电脑保持运行时适用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並允許螢幕關閉：阻止系統休眠，但允許螢幕自動熄滅。只需要電腦保持執行時適用。"
          }
        }
      }
    },
    "Keep Awake & Display On": {
      "comment": "Option to keep both system and display awake",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并保持屏幕常亮"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並保持螢幕常亮"
          }
        }
      }
    },
    "Keep Awake & Display On: prevents both system sleep and display sleep. Use it for presentations or long reading sessions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并保持屏幕常亮：同时阻止系统休眠与屏幕休眠。适合演示演示或长时间阅读时使用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並保持螢幕常亮：同時阻止系統休眠與螢幕休眠。適合簡報演示或長時間閱讀時使用。"
          }
        }
      }
    },
    "Keep Awake & Turn Off Display Now": {
      "comment": "Option to keep system awake and turn off display immediately",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并立即关闭屏幕"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並立即關閉螢幕"
          }
        }
      }
    },
    "Keep Awake & Turn Off Display Now: turns the display off immediately and keeps the system awake.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并立即关闭屏幕：立刻关闭屏幕，同时保持系统唤醒。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並立即關閉螢幕：立刻關閉螢幕，同時保持系統喚醒。"
          }
        }
      }
    },
    "Keep Screen On": {
      "comment": "Feature title",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持屏幕常亮"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "保持螢幕常亮"
          }
        }
      }
    },
    "Keep system awake, allow display sleep": {
      "comment": "Option to prevent system sleep but allow the monitor to turn off",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠，允许关闭屏幕"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠，允許關閉螢幕"
          }
        }
      }
    },
    "Keep system awake, prevent display sleep": {
      "comment": "Option to prevent both system and monitor from sleeping",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠，禁止关闭屏幕"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠，禁止關閉螢幕"
          }
        }
      }
    },
    "Key Features": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心功能"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "核心功能"
          }
        }
      }
    },
    "Low resource usage, runs silently without interruption": {
      "comment": "Feature description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低资源占用，静默运行，不打扰工作"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "低資源佔用，靜默運行，不打擾工作"
          }
        }
      }
    },
    "Manage your custom anti-sleep durations. Click the delete button to remove custom durations.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理您的自定义防睡眠时长。点击删除按钮可删除自定义时长。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "管理您的自訂防睡眠時長。點擊刪除按鈕可刪除自定義時長。"
          }
        }
      }
    },
    "Notes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意事项"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "注意事項"
          }
        }
      }
    },
    "One-click Anti-sleep": {
      "comment": "Feature title",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键防休眠"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵防休眠"
          }
        }
      }
    },
    "Open Settings and go to the Caffeinate page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置，进入「防休眠」页面。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟設定，進入「防休眠」頁面。"
          }
        }
      }
    },
    "Open the menu-bar popover and pick a duration under Duration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开菜单栏弹窗，在「时长」区选择一个时长。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟選單列彈出視窗，在「時長」區選擇一個時長。"
          }
        }
      }
    },
    "Overview": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "概述"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "概述"
          }
        }
      }
    },
    "Prevent system sleep, supporting scheduled and manual control": {
      "comment": "Description of what the Caffeinate plugin does",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止系统休眠，支持定时和手动控制"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止系統休眠，支援定時和手動控制"
          }
        }
      }
    },
    "Provide anti-sleep related poster views": {
      "comment": "Description of what the Caffeinate Poster plugin does",
      "localizations": {
        "zh-Hans": {
