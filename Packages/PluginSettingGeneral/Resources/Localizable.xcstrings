    "Wakey 已从你的 Mac 移除，应用已移到废纸篓。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakey has been removed from your Mac and moved to Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakey 已从你的 Mac 移除，应用已移到废纸篓。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakey 已從你的 Mac 移除，應用程式已移至垃圾桶。"
          }
        }
      }
    },
    "Wakey 数据已清除，应用即将退出。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakey data has been cleared. The app will now quit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakey 数据已清除，应用即将退出。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakey 資料已清除，應用程式即將結束。"
          }
        }
      }
    },
