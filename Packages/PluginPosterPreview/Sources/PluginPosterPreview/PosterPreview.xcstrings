{
  "sourceLanguage": "en",
  "strings": {
    "Generate App Store Screenshots": {
      "comment": "Button label that generates App Store screenshots",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate App Store Screenshots"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成 App Store 截图"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "產生 App Store 螢幕截圖"
          }
        }
      }
    },
    "No posters yet": {
      "comment": "Empty state title in the poster preview",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No posters yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无海报"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無海報"
          }
        }
      }
    },
    "Poster Preview": {
      "comment": "Name and title of the poster preview plugin",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poster Preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海报预览"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "海報預覽"
          }
        }
      }
    },
    "Previews all posters provided by plugins and generates App Store screenshots": {
      "comment": "Description of what the Poster Preview plugin does",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews all posters provided by plugins and generates App Store screenshots"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览所有插件提供的海报，并支持生成 App Store 截图"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽所有外掛提供的海報，並支援產生 App Store 螢幕截圖"
          }
        }
      }
    },
    "Make sure at least one plugin provides a poster configuration": {
      "comment": "Empty state hint in the poster preview",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure at least one plugin provides a poster configuration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保至少有一个插件提供了海报配置"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請確保至少有一個外掛提供了海報設定"
          }
        }
      }
    },
    "%lld poster configurations in total": {
      "comment": "Count of poster configurations",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld poster configurations in total"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 个海报配置"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 個海報設定"
          }
        }
      }
    },
    "Choose where to save the App Store screenshots.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 App Store 截图的保存位置。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 App Store 截圖的儲存位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where to save the App Store screenshots."
          }
        }
      }
    },
    "Failed to create the export folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建导出文件夹。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立匯出資料夾。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to create the export folder."
          }
        }
      }
    },
    "Exported with %lld failure(s).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出完成，但有 %lld 个文件失败。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出完成，但有 %lld 個檔案失敗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exported with %lld failure(s)."
          }
        }
      }
    },
    "Exported to %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导出到 %@。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已匯出到 %@。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exported to %@."
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中显示"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中顯示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        }
      }
    }
  },
  "version": "1.0"
}
