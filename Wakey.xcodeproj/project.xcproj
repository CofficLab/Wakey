{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "zh-Hans",
      "zh-HK",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/CofficLab/LumiKernel.git",
      "version": {
        "branch": "main",
      },
    }, {
      "kind": "local",
      "path": "Packages/FactoryWakey",
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "WakeyApp",
      "target-membership": [
        "Wakey",
      ],
      "membership-exceptions": [
        {
          "target": "Wakey",
          "exclusions": [
            "Wakey-Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "WakeyUITests", "target-membership": [ "WakeyUITests" ] },
    { "path": "<PRODUCTS>/Wakey.app", "id": "F53C49142F1A42EC00929321", "type": "wrapper.application", "index": false },
    { "path": "<PRODUCTS>/WakeyUITests.xctest", "id": "5E97DD71ADF24E7C774F14F2", "type": "wrapper.cfbundle", "index": false },
    { "kind": "group", "name": "Frameworks" },
  ],
  "targets": [
    {
      "name": "Wakey",
      "id": "F54F8C7D2F1A3B6500AABB2A",
      "product": "Wakey.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "FactoryWakey",
          "product-name": "FactoryWakey",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "LumiKernel",
          "product-name": "KernelCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "WakeyApp/Wakey.entitlements",
        "CODE_SIGN_IDENTITY[sdk=macosx*]": "-",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "3",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "Y6HZ9JJYV6",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "WakeyApp/Wakey-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Wakey",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "1.11.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.coffic.wakey",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "WakeyUITests",
      "id": "0AE2DDA18B22DC9EAE34F2DB",
      "product": "WakeyUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "Wakey",
      "dependencies": [
        "Wakey",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_APP_SANDBOX": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "14.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.coffic.wakey.uitests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "macosx",
        "SWIFT_VERSION": "6.0",
        "TEST_TARGET_NAME": "Wakey",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
